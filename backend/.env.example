# Behavior Intelligence Engine - Configuration Template

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/behavior_db
# For development: sqlite:///./behavior_engine.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# ML Model Configuration
MODEL_SAVE_PATH=./models/productivity_model.pkl
RETRAIN_INTERVAL_DAYS=7

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/behavior_engine.log

# Feature Extraction Configuration
DEFAULT_HISTORY_DAYS=90
MIN_SAMPLES_FOR_TRAINING=10

# API Configuration
API_TITLE=Behavior Intelligence API
API_VERSION=1.0.0
