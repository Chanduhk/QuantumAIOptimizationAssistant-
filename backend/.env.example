# Behavior Intelligence Engine - Configuration Template

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/behavior_db
# For development: sqlite:///./behavior_engine.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# ML Model Configuration
MODEL_SAVE_PATH=./models/productivity_model.pkl
RETRAIN_INTERVAL_DAYS=7

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/behavior_engine.log

# Feature Extraction Configuration
DEFAULT_HISTORY_DAYS=90
MIN_SAMPLES_FOR_TRAINING=10

# API Configuration
API_TITLE=Behavior Intelligence API
API_VERSION=1.0.0

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Primary LLM Provider: gemini (default), openai, anthropic, groq, ollama
HELIOX_LLM_PROVIDER=gemini

# ============================================================================
# Google Gemini Provider Configuration (Primary LLM)
# ============================================================================
# Set your Google Gemini API key to enable LLM-powered natural language planning.
# If left blank, HELIOX AI operates with full functionality using its deterministic
# rule-based planning parser without failing or requiring third-party credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT=10.0

# ============================================================================
# OpenAI Provider Configuration (Alternative LLM)
# ============================================================================
# Set your OpenAI API key here to use OpenAI instead of Gemini (requires HELIOX_LLM_PROVIDER=openai).
OPENAI_API_KEY=

# Model to use for planning extraction. Supported options: gpt-4o-mini, gpt-4o.
# Default: gpt-4o-mini (fast, cost-effective, supports structured outputs)
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom OpenAI-compatible endpoint or proxy (e.g. Azure, LiteLLM, Ollama)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Request timeout in seconds (default: 10.0)
# OPENAI_TIMEOUT=10.0
